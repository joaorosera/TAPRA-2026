	column 'Data Criacao' = DATE ( YEAR ( dbo_chamado[dt_criacao] ), MONTH ( dbo_chamado[dt_criacao] ), DAY ( dbo_chamado[dt_criacao] ) )
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 73248ded-601e-41be-acba-38a4aedea132
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data Resolucao' =
			IF (
			    ISBLANK ( dbo_chamado[dt_resolucao] ),
			    BLANK (),
			    DATE ( YEAR ( dbo_chamado[dt_resolucao] ), MONTH ( dbo_chamado[dt_resolucao] ), DAY ( dbo_chamado[dt_resolucao] ) )
			)
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: c05ebd01-3f03-4161-a1bd-9465b75d9559
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Grupo Status' =
			VAR s = LOWER ( TRIM ( dbo_chamado[ds_status_chamado] ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        s IN { "aberto", "em andamento", "pendente" }, "Backlog",
			        s IN { "resolvido", "fechado" }, "Resolvido",
			        s = "cancelado", "Cancelado",
			        "Outro"
			    )
		dataType: string
		lineageTag: 0a91d62a-7b59-4d44-a9b6-123d4b96c81d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Analista = COALESCE ( RELATED ( dbo_analista[nm_analista] ), "Sem analista" )
		dataType: string
		lineageTag: b353b6bb-69b6-491a-abd2-389ffe714f00
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Nivel Analista' = COALESCE ( RELATED ( dbo_analista[ds_nivel] ), "Sem analista" )
		dataType: string
		lineageTag: 7afeebf0-8f1c-4fb8-ae4b-0dbaa1b8db38
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Categoria = COALESCE ( RELATED ( dbo_categoria[nm_categoria] ), "Sem categoria" )
		dataType: string
		lineageTag: eb72d45d-2863-4dff-a8dc-e3333c680060
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Fila = COALESCE ( RELATED ( dbo_fila[nm_fila] ), "Sem fila" )
		dataType: string
		lineageTag: 1e9ceed6-2cce-4aca-a953-265afda4cc7a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Cliente = RELATED ( dbo_cliente_organizacao[nm_cliente_organizacao] )
		dataType: string
		lineageTag: e3ff0525-591e-4d46-a42e-8c9d0cda907e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Horas Resolucao' =
			IF (
			    ISBLANK ( dbo_chamado[dt_resolucao] ),
			    BLANK (),
			    DATEDIFF ( dbo_chamado[dt_criacao], dbo_chamado[dt_resolucao], MINUTE ) / 60
			)
		dataType: double
		formatString: #,0.0
		lineageTag: 4e58a0d1-1eb8-4a35-a426-4fae2189cf5e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dbo_chamado = m
		mode: import
		source =
				let
				    Fonte = Sql.Database(ServidorSql, BancoSql),
				    dbo_chamado = Fonte{[Schema = "dbo", Item = "chamado"]}[Data],
				    OrdemPrioridade = Table.AddColumn(dbo_chamado, "Ordem Prioridade", each
				        let p = Text.Lower(Text.Trim([ds_prioridade])) in
				        if p = "crítica" or p = "critica" then 1
				        else if p = "alta" then 2
				        else if p = "média" or p = "media" then 3
				        else if p = "baixa" then 4
				        else 9, Int64.Type)
				in
				    OrdemPrioridade

	annotation PBI_ResultType = Table
